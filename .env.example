# Pfad zur SQLite-Datenbank (relativ zum prisma/-Ordner)
DATABASE_URL="file:../data/app.db"

# Optional: Anthropic-API-Key für die echte KI-Analyse (console.anthropic.com).
# Alternativ kann der Key in der App unter "Einstellungen" hinterlegt werden.
# Ohne Key läuft die App vollständig im Demo-Modus.
# ANTHROPIC_API_KEY="sk-ant-..."

# Optional: Claude-Modell überschreiben (Standard siehe src/lib/ai/claude.ts)
# ROOMDESIGN_CLAUDE_MODEL="claude-sonnet-4-5"
